{
  "DbConnections": [
    {
      "ConnId": "WMMETAMINE_MYSQL",
      "DBType": 0,
      "Enabled": true,
      "HitRate": 100,
      "Connection": "server=127.0.0.1;Database=dispatch;Uid=root;Pwd=123456;Port=3306;Allow User Variables=True;pooling=true;min pool size=5;max pool size=500;connect timeout = 20;"
    },
    {
      "ConnId": "WMMETAMINE_MYSQL_2",
      "DBType": 0,
      "Enabled": true,
      "HitRate": 20,
      "Connection": "server=127.0.0.1;Database=dispatch_log;Uid=root;Pwd=123456;Port=3306;Allow User Variables=True;pooling=true;min pool size=5;max pool size=500;connect timeout = 20;"
    }
  ],
  // 配置键与 BiReportOptions 的属性同名（与上面的 DbConnections 一致）：
  // 配置绑定是按属性名匹配的，不写 PascalCase 会静默绑定失败、全部落到默认值。
  "BiQuery": {
    "Enabled": true,
    "DefaultPageSize": 20,
    "MaxPageSize": 200,
    "MaxSelectColumns": 100,
    "MaxJoinTables": 8,
    "MaxWhereConditions": 30,
    "MaxInValues": 1000,
    "MaxOrderBy": 5,
    "ExportMaxRows": 20000,
    "MaxExportCells": 500000,
    "ExportTruncateWhenExceed": false,
    "QueryTimeoutMs": 30000,
    "SchemaCacheSeconds": 300,
    "MetadataRefreshEnabled": true,
    // 单张逻辑分表最多合并多少个物理分表（按月分表 240 张约等于 20 年）
    "MaxShardsPerTable": 240,
    // 只声明「哪些表可以查」。表和表之间怎么关联不在这里配置——
    // 关联条件由前端在查询请求的 joins 里现场给出，服务端只校验两端列存在且类型同族。
    // 这样加表、改表结构都不用同步维护一份关联清单
    "Tables": [
      {
        "Name": "truck",
        "DisplayName": "矿卡信息",
        "ExcludeColumns": [ "cors_password", "cors_name", "iot_ip" ],
        "ColumnDisplayNames": {
          "truck_code": "矿卡自编码",
          "truck_name": "矿卡名称"
        }
      },
      {
        "Name": "truck_lift_record",
        "DisplayName": "矿卡举升记录",
        "ExcludeColumns": []
      },
      {
        // 挖机信息表，位于默认业务库 dispatch
        "Name": "shovel",
        "DisplayName": "铲车信息",
        "ExcludeColumns": [ "cors_password", "cors_name", "iot_ip" ]
      },
      {
        // 班次字典表，位于默认业务库 dispatch；
        // 日志表的 shift_type 可与 shift_type_code 关联出班次名称
        "Name": "shift_type",
        "DisplayName": "班次信息",
        "ExcludeColumns": [],
        "ColumnDisplayNames": {
          "shift_type_code": "班次编码",
          "shift_type_name": "班次名称",
          "start_time": "开始时间",
          "end_time": "结束时间",
          "is_across_day": "是否跨天"
        }
      },
      {
        // 按月分表的逻辑表：物理表在日志库 dispatch_log 里，
        // 形如 load_shovel_task_record_20250501。
        // Database 必须和默认连接在同一个 MySQL 实例上，否则没法在一条 SQL 里 join。
        "Name": "load_shovel_task_record",
        "DisplayName": "铲装任务记录",
        "Database": "dispatch_log",
        "ShardTablePrefix": "load_shovel_task_record_",
        "ShardNameDateFormat": "yyyyMMdd",
        // 查询里对 working_date 的日期过滤会用来裁剪要扫的月份分表
        "ShardDateColumn": "working_date",
        "ExcludeColumns": []
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
